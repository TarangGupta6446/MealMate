<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order Details"
            android:textColor="#292321"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Here is everything about your order."
            android:textColor="#827773"
            android:textSize="14sp" />

        <!-- Order Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ORDER INFORMATION"
                android:textColor="#FF6B35"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Order ID"
                android:textColor="#292321"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Status: Preparing"
                android:textColor="#FF6B35"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Order date"
                android:textColor="#827773"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Order Tracking Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ORDER TRACKING"
            android:textColor="#292321"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Order Tracking Card -->
        <LinearLayout
            android:id="@+id/trackingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_background"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Order Placed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlacedIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="#FFF0E8"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FF6B35"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlacedTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Order Placed"
                        android:textColor="#292321"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Your order has been received"
                        android:textColor="#827773"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/linePlaced"
                android:layout_width="2dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:background="#E5DCD6" />

            <!-- Preparing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreparingIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="#F3EDE9"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#827773"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPreparingTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Preparing"
                        android:textColor="#827773"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Your food is being prepared"
                        android:textColor="#827773"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/linePreparing"
                android:layout_width="2dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:background="#E5DCD6" />

            <!-- Out for Delivery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDeliveryIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="#F3EDE9"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#827773"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDeliveryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Out for Delivery"
                        android:textColor="#827773"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Your order is on its way"
                        android:textColor="#827773"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/lineDelivery"
                android:layout_width="2dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:background="#E5DCD6" />

            <!-- Delivered -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDeliveredIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="#F3EDE9"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="#827773"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDeliveredTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delivered"
                        android:textColor="#827773"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Enjoy your meal!"
                        android:textColor="#827773"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Cancelled Order Message: Outside Tracking Card -->
        <TextView
            android:id="@+id/tvCancelledMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF0EE"
            android:padding="14dp"
            android:text="This order has been cancelled."
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Your Items Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="YOUR ITEMS"
            android:textColor="#292321"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailFoodItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_background"
            android:lineSpacingExtra="8dp"
            android:padding="16dp"
            android:text="Loading items..."
            android:textColor="#413732"
            android:textSize="15sp" />

        <!-- Delivery Information Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DELIVERY INFORMATION"
            android:textColor="#292321"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Delivery Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivery Address"
                android:textColor="#827773"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Address"
                android:textColor="#292321"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Phone Number"
                android:textColor="#827773"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Phone"
                android:textColor="#292321"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Payment Summary Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PAYMENT SUMMARY"
            android:textColor="#292321"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Payment Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment Method"
                android:textColor="#827773"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Not recorded"
                android:textColor="#292321"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#E5DCD6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Amount"
                android:textColor="#827773"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="₹0"
                android:textColor="#FF6B35"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Cancel Order Button -->
        <Button
            android:id="@+id/btnCancelOrder"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#D32F2F"
            android:text="Cancel Order"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackToOrders"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FF6B35"
            android:text="Back to My Orders"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>