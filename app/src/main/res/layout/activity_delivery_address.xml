<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delivery Address"
            android:textColor="#292321"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:text="Save your details for a quicker checkout."
            android:textColor="#827773"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Address"
            android:textColor="#292321"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_background"
            android:gravity="top|start"
            android:hint="House no., street, area, city"
            android:inputType="textPostalAddress|textMultiLine"
            android:padding="14dp"
            android:textColor="#292321"
            android:textColorHint="#99908B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Phone Number"
            android:textColor="#292321"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDeliveryPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_background"
            android:hint="Enter 10-digit phone number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="14dp"
            android:textColor="#292321"
            android:textColorHint="#99908B"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#FF6B35"
            android:text="Save Address"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelAddress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFE0D3"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#292321"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>