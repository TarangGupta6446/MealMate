<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    tools:context=".OrdersActivity">

    <!-- Scrollable Orders Content -->
    <ScrollView
        android:id="@+id/ordersScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationInclude"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <TextView
                android:id="@+id/tvOrdersTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Orders"
                android:textColor="#222222"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvOrdersSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Track your food orders"
                android:textColor="#888888"
                android:textSize="14sp" />

            <!-- Current Orders Heading -->
            <TextView
                android:id="@+id/tvCurrentOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Current Orders"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Current Orders -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCurrentOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false"
                tools:listitem="@layout/item_order" />

            <!-- Previous Orders Heading -->
            <TextView
                android:id="@+id/tvPreviousOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Previous Orders"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Previous Orders -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPreviousOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false"
                tools:listitem="@layout/item_order" />

        </LinearLayout>

    </ScrollView>

    <!-- Shared Bottom Navigation -->
    <include
        android:id="@+id/bottomNavigationInclude"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="65dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>