<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    tools:context=".CheckoutActivity">

    <!-- Checkout Header -->
    <LinearLayout
        android:id="@+id/checkoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <TextView
            android:id="@+id/tvCheckoutBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/food_back_button_background"
            android:clickable="true"
            android:contentDescription="Go back"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="#FF6B35"
            android:textSize="34sp" />

        <!-- Title and Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCheckoutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checkout"
                android:textColor="#171717"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCheckoutSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Almost there! Complete your order"
                android:textColor="#827773"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable Checkout Content -->
    <ScrollView
        android:id="@+id/checkoutScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/checkoutHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomCheckoutCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <!-- Delivery Address Heading -->
            <TextView
                android:id="@+id/tvAddressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Address"
                android:textColor="#171717"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Delivery Address Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Where should we deliver?"
                        android:textColor="#827773"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/search_background"
                        android:gravity="top|start"
                        android:hint="Enter your complete delivery address"
                        android:inputType="textPostalAddress|textMultiLine|textCapSentences"
                        android:minLines="2"
                        android:padding="14dp"
                        android:textColor="#222222"
                        android:textColorHint="#99918D"
                        android:textSize="14sp"
                        android:autofillHints="postalAddress" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Contact Number"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/search_background"
                        android:hint="Enter your 10-digit phone number"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#222222"
                        android:textColorHint="#99918D"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:autofillHints="phone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Order Summary Heading -->
            <TextView
                android:id="@+id/tvSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Order Summary"
                android:textColor="#171717"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Order Summary Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/orderSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR ORDER"
                        android:textColor="#99918D"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvOrderItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="5dp"
                        android:text="Your selected food items"
                        android:textColor="#413B38"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp"
                        android:background="#F0E7E1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Amount"
                            android:textColor="#171717"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textColor="#FF6B35"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Payment Method Heading -->
            <TextView
                android:id="@+id/tvPaymentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Payment Method"
                android:textColor="#171717"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Payment Options Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <RadioGroup
                    android:id="@+id/rgPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <RadioButton
                        android:id="@+id/rbCash"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:buttonTint="#FF6B35"
                        android:checked="true"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Cash on Delivery"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="#F2E9E2" />

                    <RadioButton
                        android:id="@+id/rbOnline"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:buttonTint="#FF6B35"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Online Payment"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                </RadioGroup>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- Fixed Bottom Place Order Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomCheckoutCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FF5722"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Place Order"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>